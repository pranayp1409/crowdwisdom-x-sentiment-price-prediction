# Copy this file to .env and fill in credentials locally. Never commit .env.
ASSET=BTC-USD
BAR_INTERVAL=hourly
LOOKBACK_DAYS=180

# Configure KaitoEasyAPI's pay-per-result Actor; review pricing before collecting.
APIFY_API_TOKEN=
APIFY_ACTOR_ID=kaitoeasyapi/twitter-x-data-tweet-scraper-pay-per-result-cheapest
# The app expands Unix-time placeholders into daily searchTerms in one Actor run.
# The Actor applies maxItems per term; its documentation says pagination can exceed it.
APIFY_INPUT_JSON={"searchTerms":["BTC since_time:{{since_time}} until_time:{{until_time}}"],"queryType":"Latest","maxItems":20}
APIFY_MAX_DATASET_ITEMS=10000
APIFY_RUN_TIMEOUT_SECONDS=1800

# Optional; required to use the protected application-data reset control.
APP_ADMIN_PASSWORD=

# Optional news providers. At least one can be configured.
TAVILY_API_KEY=
EXA_API_KEY=

DATABASE_PATH=data/agent.sqlite3
ARTIFACTS_DIR=artifacts
REPORTS_DIR=reports
