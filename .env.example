# Copy this file to .env and fill in credentials locally. Never commit .env.
ASSET=BTC-USD
BAR_INTERVAL=hourly
LOOKBACK_DAYS=180

# Configure an Apify actor that returns X posts. Actor input is actor-specific.
APIFY_API_TOKEN=
APIFY_ACTOR_ID=apidojo/twitter-scraper-lite
# start/end are replaced with consecutive monthly date windows. This starts one
# Actor run per window; maxItems is the Actor-side result cap for each run.
APIFY_INPUT_JSON={"searchTerms":["BTC"],"sort":"Latest","maxItems":20,"includeSearchTerms":false,"start":"{{since}}","end":"{{until}}"}
APIFY_MAX_DATASET_ITEMS=10000
APIFY_RUN_TIMEOUT_SECONDS=1800

# Optional news providers. At least one can be configured.
TAVILY_API_KEY=
EXA_API_KEY=

DATABASE_PATH=data/agent.sqlite3
ARTIFACTS_DIR=artifacts
REPORTS_DIR=reports
